#!/usr/bin/make -f
QUERENCIA_KIND := data
include debian/querencia.mk

BILDER := data/hintergruende

querencia-install:
	# 32 PNG (16 Bilder je 2560x1440 und 4:3) gegen die SHA256SUMS des
	# Upstream-Repos; die Namen (querencia-<stamm>[-4x3].png) überschneiden
	# sich nicht mit den 17 Bildern von querencia-shell im selben Ordner.
	cd $(BILDER) && sha256sum -c --quiet SHA256SUMS
	test $$(ls $(BILDER)/*.png | wc -l) -eq 32
	test $$(grep -c '\.png$$' $(BILDER)/SHA256SUMS) -eq 32
	install -d $(DESTDIR)/usr/share/querencia/hintergruende
	install -m 0644 $(BILDER)/*.png $(DESTDIR)/usr/share/querencia/hintergruende/
	for f in blau blau2 abend erde nacht; do \
		test ! -e $(DESTDIR)/usr/share/querencia/hintergruende/querencia-$$f.png; done
	# Doku: COPYRIGHT, Herkunft je Bild, Markenregel; CHANGELOG als changelog.gz
	$(call doc_install,.,COPYRIGHT)
	install -m 0644 docs/herkunft.md docs/marke.md $(DESTDIR)/usr/share/doc/$(PKG)/
