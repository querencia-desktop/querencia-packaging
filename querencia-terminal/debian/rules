#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-terminal $(DESTDIR)/usr/bin/querencia-terminal
	# Alte Application-ID bis zur Umstellung auf org.querencia.Terminal
	$(call desktop_install,data/org.example.Querencia.Terminal.desktop,$(DESTDIR)/usr/share/applications/org.example.Querencia.Terminal.desktop)
	$(call metainfo_install,org.example.Querencia.Terminal)
	$(call doc_install,.)
