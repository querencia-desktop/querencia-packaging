#!/usr/bin/make -f
QUERENCIA_KIND := data
include debian/querencia.mk

# Ausgabe für /usr/share/querencia/{version,release}, gelesen von den
# Info-Dialogen (Panel, Einstellungen); Format: docs/versionsdatei.md.
# VERSION_ID ist die Upstream-Version dieses Pakets.
AUSGABE := Alpha 3.6

querencia-install:
	install -D -m 0644 debian/README.Debian $(DESTDIR)/usr/share/doc/querencia-desktop/README.Debian
	install -d $(DESTDIR)/usr/share/querencia
	printf '%s\n' '$(AUSGABE)' >$(DESTDIR)/usr/share/querencia/version
	printf '%s\n' 'NAME="Querencia Desktop"' 'VERSION="$(AUSGABE)"' \
		'VERSION_ID="$(UPSTREAM_VERSION)"' 'HOME_URL="https://querencialinux.org"' \
		'BUG_REPORT_URL="https://github.com/querencia-desktop/querencia/issues"' \
		'DOCUMENTATION_URL="https://querencialinux.org/de/docs/"' \
		>$(DESTDIR)/usr/share/querencia/release
