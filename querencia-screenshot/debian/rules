#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-screenshot $(DESTDIR)/usr/bin/querencia-screenshot
	# Desktop-Datei aus debian/ (querencia-screenshot-dev hat keine)
	$(call desktop_install,debian/org.querencia.Screenshot.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Screenshot.desktop)
	$(call metainfo_install,org.querencia.Screenshot)
	$(call doc_install,.)
