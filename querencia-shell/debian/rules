#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

PROGRAMME := querencia-panel querencia-desktop querencia-kuerzel querencia-lautstaerke querencia-netzwerk
GTKTHEMA := querencia-thema/Querencia-Klassisch
# labwc-Themen hell und dunkel (seit Thema 0.2.2 im Thema-Repo; Einstellungen
# schalten <theme><name> in rc.xml mit der dunklen Darstellung um)
LABWCTHEMEN := querencia-thema/labwc

querencia-install:
	for p in $(PROGRAMME); do install -D -m 0755 target/release/$$p $(DESTDIR)/usr/bin/$$p; done
	# Standardhintergründe (Querencia Blau, G2-AF: vier Motive je 16:9/4:3,
	# ohne/mit Q-Logo); Einstellungen und Desktop suchen in den
	# XDG-Datenordnern unter querencia/hintergruende/.
	install -d $(DESTDIR)/usr/share/querencia/hintergruende
	install -m 0644 data/hintergruende/*.png $(DESTDIR)/usr/share/querencia/hintergruende/
	test $$(ls $(DESTDIR)/usr/share/querencia/hintergruende/*.png | wc -l) -eq 17
	# Fensterthemen für labwc (<theme><name>Querencia-Klassisch</name> in
	# rc.xml, dunkel Querencia-Klassisch-Dunkel); je themerc und 16 Knöpfe
	set -e; for t in Querencia-Klassisch Querencia-Klassisch-Dunkel; do \
		install -d $(DESTDIR)/usr/share/themes/$$t/labwc; \
		install -m 0644 $(LABWCTHEMEN)/$$t/themerc $(LABWCTHEMEN)/$$t/*.png $(DESTDIR)/usr/share/themes/$$t/labwc/; \
		test $$(ls $(DESTDIR)/usr/share/themes/$$t/labwc | wc -l) -eq 17; done
	# GTK-Thema (Komponente querencia-thema) im selben Themenordner; seit
	# Thema 0.2 mit gtk-dark.css (dunkle Fassung, prefer-dark)
	install -m 0644 $(GTKTHEMA)/index.theme $(DESTDIR)/usr/share/themes/Querencia-Klassisch/index.theme
	set -e; for g in gtk-3.0 gtk-4.0; do \
		install -d $(DESTDIR)/usr/share/themes/Querencia-Klassisch/$$g/assets; \
		install -m 0644 $(GTKTHEMA)/$$g/gtk.css $(GTKTHEMA)/$$g/gtk-dark.css $(DESTDIR)/usr/share/themes/Querencia-Klassisch/$$g/; \
		install -m 0644 $(GTKTHEMA)/$$g/assets/*.svg $(DESTDIR)/usr/share/themes/Querencia-Klassisch/$$g/assets/; done
	$(call desktop_install,crates/querencia-kuerzel/data/org.querencia.Kuerzel.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Kuerzel.desktop)
	$(call desktop_nur_querencia,$(DESTDIR)/usr/share/applications/org.querencia.Kuerzel.desktop)
	install -D -m 0644 crates/querencia-kuerzel/data/org.querencia.Kuerzel.svg \
		$(DESTDIR)/usr/share/icons/hicolor/scalable/apps/org.querencia.Kuerzel.svg
	# Symbol der Lautstärke kommt aus querencia-symbole (PNG-Stufen und SVG)
	$(call desktop_install,crates/querencia-lautstaerke/data/org.querencia.Lautstaerke.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Lautstaerke.desktop)
	$(call desktop_nur_querencia,$(DESTDIR)/usr/share/applications/org.querencia.Lautstaerke.desktop)
	$(call metainfo_install,org.querencia.Panel org.querencia.Desktop)
	# Übersetzungen (gettext, msgid englisch): Panel mit den Textdomänen
	# seiner Applets Lautstärke und Netzwerk, Arbeitsfläche; gesucht in
	# /usr/share/locale (i18n.rs der Crates)
	$(call mo_install,crates/querencia-panel/po,querencia-panel)
	$(call mo_install,crates/querencia-lautstaerke/po,querencia-lautstaerke)
	$(call mo_install,crates/querencia-netzwerk/po,querencia-netzwerk)
	$(call mo_install,crates/querencia-desktop/po,querencia-desktop)
	# Kein README: das der Runtime beschreibt die Entwicklungs-VM.
