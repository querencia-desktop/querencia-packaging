#!/usr/bin/make -f
QUERENCIA_KIND := data
include debian/querencia.mk

querencia-install:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	sh tests/run.sh
endif
	$(MAKE) install DESTDIR=$(DESTDIR) PREFIX=/usr SYSCONFDIR=/etc
	$(call doc_install,.)
	install -d $(DESTDIR)/usr/share/doc/querencia-session/examples/greetd
	install -m 0644 examples/greetd/* $(DESTDIR)/usr/share/doc/querencia-session/examples/greetd/
	# Portale der Sitzung (Pflichtprobe B6) installiert das Makefile des
	# Upstreams aus share/xdg-desktop-portal/ (seit 0.1.0~alpha4)
	test -f $(DESTDIR)/usr/share/xdg-desktop-portal/x-querencia-portals.conf
	# Erscheinungsbild nur für XDG_CURRENT_DESKTOP=X-Querencia (Pflichtprobe B7)
	install -D -m 0644 debian/20_querencia-session.gschema.override \
		$(DESTDIR)/usr/share/glib-2.0/schemas/20_querencia-session.gschema.override
	# Override gegen das Schema aus gsettings-desktop-schemas prüfen (strikt:
	# unbekannte Schlüssel oder Typfehler brechen den Bau ab)
	rm -rf debian/schema-probe; mkdir -p debian/schema-probe
	cp /usr/share/glib-2.0/schemas/org.gnome.desktop.interface.gschema.xml \
		/usr/share/glib-2.0/schemas/org.gnome.desktop.enums.xml \
		debian/20_querencia-session.gschema.override debian/schema-probe/
	glib-compile-schemas --strict --targetdir=debian/schema-probe debian/schema-probe
	rm -rf debian/schema-probe
