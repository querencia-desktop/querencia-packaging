Description: Panel unter seiner Überwachung starten, wenn es das kann
 Panel 0.2.3 hat den Modus --ueberwacht: ein kleiner Elternprozess startet
 ein abgestürztes Panel neu (höchstens 3-mal in 10 Minuten, mit einer
 Protokollzeile). Der Autostart fragt "querencia-panel --faehigkeiten" und
 startet nur ein Panel, das "ueberwacht" nennt, auf diese Weise; ein älteres
 Panel startet wie bisher. Die Record-Datei nennt dann die PID der
 Überwachung, deren SIGTERM auch das Panel beendet.
 Übernommen unverändert aus der labwc-Vorgabe von querencia-runtime
 (Code-Tag panel/ueberwacht-1 = 7ad985a, session/querencia/labwc/autostart).
Author: pottrauschen <147073098+pottrauschen@users.noreply.github.com>
Origin: querencia-runtime, commit 7ad985a57c610abd9e0cf8075e0e3fe5450189b2
Forwarded: not-needed (gleiche Änderung im Upstream der Vorgabe)
Last-Update: 2026-10-22
---
--- a/labwc/autostart
+++ b/labwc/autostart
@@ -81,9 +81,18 @@
     fi
 fi
 
-gtk_exec "$QUERENCIA_PANEL" </dev/null >>"$QUERENCIA_STATE_DIR/panel.log" 2>&1 &
+# Panel 0.2.3 and later: under its watchdog (--ueberwacht), which starts a
+# crashed panel again, at most 3 times in 10 minutes, with a log line
+# (docs/panel-023-absturz-und-ueberwachung.md). Only for a panel that names
+# the capability; an older one starts as before.
+if "$QUERENCIA_PANEL" --faehigkeiten 2>/dev/null </dev/null | grep -qw ueberwacht; then
+    gtk_exec "$QUERENCIA_PANEL" --ueberwacht </dev/null >>"$QUERENCIA_STATE_DIR/panel.log" 2>&1 &
+else
+    gtk_exec "$QUERENCIA_PANEL" </dev/null >>"$QUERENCIA_STATE_DIR/panel.log" 2>&1 &
+fi
 
-# Record "PID STARTTIME" for the starter's cleanup (see starttime() there).
+# Record "PID STARTTIME" for the starter's cleanup (see starttime() there);
+# with the watchdog it is the watchdog's PID: its SIGTERM ends the panel too.
 pid=$!
 if stat=$(cat "/proc/$pid/stat" 2>/dev/null); then
     set -- ${stat##*) }
