#!/usr/bin/make -f
# Unit-Tests ohne Daemon (Attrappen, QS_ATTRAPPE=1); die Tests gegen den
# privaten packagekitd (SW-1 PRUEFGERUEST.md) laufen getrennt.
export QS_ATTRAPPE := 1
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES := --manifest-path querencia-software/Cargo.toml
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-software $(DESTDIR)/usr/bin/querencia-software
	$(call desktop_install,querencia-software/programm/data/org.querencia.Software.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Software.desktop)
	grep -qx 'Exec=querencia-software' $(DESTDIR)/usr/share/applications/org.querencia.Software.desktop
	# Nur SVG, nie 48x48 (GTK-4.22-Symbolabsturz, pakete-pruefen.sh).
	install -D -m 0644 debian/org.querencia.Software.svg \
		$(DESTDIR)/usr/share/icons/hicolor/scalable/apps/org.querencia.Software.svg
	$(call mo_install,querencia-software/programm/po,querencia-software)
	$(call metainfo_install,org.querencia.Software)
	# Katalog-Ergänzungen (ab 0.1.6, docs/katalog-ergaenzungen.md upstream):
	# programm/data/swcatalog hat den Aufbau von /usr/share/swcatalog.
	install -D -m 0644 querencia-software/programm/data/swcatalog/xml/querencia-ergaenzungen.xml \
		$(DESTDIR)/usr/share/swcatalog/xml/querencia-ergaenzungen.xml
	set -e; for s in 64x64 128x128; do for f in querencia-software/programm/data/swcatalog/icons/querencia-ergaenzungen/$$s/*.png; do \
		install -D -m 0644 $$f $(DESTDIR)/usr/share/swcatalog/icons/querencia-ergaenzungen/$$s/$$(basename $$f); done; done
	# README nennt Arbeitsordner der Entwicklungs-VM (~/projects/...); nur das Änderungsprotokoll.
	$(call doc_install,querencia-software/programm,-)
