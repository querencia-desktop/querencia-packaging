#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-bilder $(DESTDIR)/usr/bin/querencia-bilder
	$(call desktop_install,data/org.querencia.Bilder.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Bilder.desktop)
	# Bewusst keine MimeType-Zeile: sonst würde GIO das Paket in jeder Sitzung
	# zum Standard für Bilder machen (QI-01).
	! grep -q '^MimeType=' $(DESTDIR)/usr/share/applications/org.querencia.Bilder.desktop
	$(call metainfo_install,org.querencia.Bilder)
	$(call doc_install,.)
