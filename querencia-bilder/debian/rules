#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-bilder $(DESTDIR)/usr/bin/querencia-bilder
	$(call desktop_install,data/org.querencia.Bilder.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Bilder.desktop)
	# Kataloge aus po/ (englische msgids, ENTSCHEIDUNGEN Nr. 16)
	set -e; for l in $$(sed 's/#.*//' po/LINGUAS); do \
		install -d $(DESTDIR)/usr/share/locale/$$l/LC_MESSAGES; \
		msgfmt --check -o $(DESTDIR)/usr/share/locale/$$l/LC_MESSAGES/querencia-bilder.mo po/$$l.po; done
	test -s $(DESTDIR)/usr/share/locale/de/LC_MESSAGES/querencia-bilder.mo
	$(call metainfo_install,org.querencia.Bilder)
	$(call doc_install,.)
