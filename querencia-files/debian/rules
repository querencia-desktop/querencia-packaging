#!/usr/bin/make -f
# Übergangspaket (ab Alpha 3): Querencia Dateien löst Querencia Files ab, der
# Strata-Fork wird nicht mehr ausgeliefert. Das Paket enthält nur noch die
# beiden Brücken-Starter auf querencia-dateien; ein Upgrade ersetzt das alte
# Paket samt Programm, und alte Verknüpfungen (Panel, Arbeitsfläche,
# mimeapps.list) öffnen weiter Querencia Dateien. Quelle ist das
# Projekt-Repository (wie beim Metapaket); kein Code von Files oder Strata.
QUERENCIA_KIND := data
include debian/querencia.mk

querencia-install:
	install -d $(DESTDIR)/usr/share/applications
	set -e; for id in org.querencia.Files io.github.lgse.Strata; do \
		f=$(DESTDIR)/usr/share/applications/$$id.desktop; \
		$(call desktop_install,debian/$$id.desktop,$$f); \
		grep -qx 'NoDisplay=true' $$f; \
		grep -qx 'Exec=querencia-dateien %U' $$f; \
		grep -qx 'TryExec=querencia-dateien' $$f; \
		grep -qx 'StartupWMClass=org.querencia.Dateien' $$f; \
		! grep -q '^MimeType=' $$f; done
	install -D -m 0644 debian/README.Debian $(DESTDIR)/usr/share/doc/querencia-files/README.Debian
