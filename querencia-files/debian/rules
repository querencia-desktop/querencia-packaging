#!/usr/bin/make -f
QUERENCIA_KIND := rust
# The full suite (~2760 tests, 14-18 min, up to 5.5 GiB) has 61 known
# environment failures (portal services, GVfs smb, GUI without Wayland) that
# also fail in the unmodified Strata base. It runs separately (TESTING.md of Strata),
# not inside the package build.
QUERENCIA_TEST := no
CARGO_FEATURES := --no-default-features
# Strata needs rustc >= 1.98 (uses APIs stabilised after 1.93, e.g.
# atomic_try_update; kstring 2.0.4 declares rust-version 1.96). Ubuntu 26.04
# has 1.93.1, so prototypes build with DEB_BUILD_PROFILES=pkg.querencia.fremdrust
# and QUERENCIA_RUST_BIN=<toolchain>/bin (querencia-packaging docs/building.md).
# Update checks against GitHub/AUR: since QF-0q (files/qf-0q-1) the upstream
# constant services::SELF_UPDATE (false) keeps Strata's own updater still (no
# thread, no connection, no "update available"); the former build-time patch
# 0001-update-pruefung-abschaltbar.patch is no longer needed.
export STRATA_BUILD_KIND := alpha
export STRATA_BUILD_COMMIT := $(shell head -n 1 debian/upstream-commit 2>/dev/null)
# Paketversion im Info-Dialog (build_info::QUERENCIA_PACKAGE_VERSION)
export QUERENCIA_PACKAGE_VERSION := $(shell dpkg-parsechangelog -S Version)
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/strata $(DESTDIR)/usr/bin/querencia-files
	# Querencia Dateien replaces Files (Welle C): both desktop IDs of Files
	# are hidden bridges without MIME types that start querencia-dateien
	# (M5 org.querencia.Files, M4 io.github.lgse.Strata; see the files). The
	# program querencia-files itself has no visible starter any more and is
	# started from a terminal; the package goes away after this release.
	install -d $(DESTDIR)/usr/share/applications
	set -e; for id in org.querencia.Files io.github.lgse.Strata; do \
		f=$(DESTDIR)/usr/share/applications/$$id.desktop; \
		$(call desktop_install,debian/$$id.desktop,$$f); \
		grep -qx 'NoDisplay=true' $$f; \
		grep -qx 'Exec=querencia-dateien %U' $$f; \
		! grep -q '^MimeType=' $$f; done
	$(call metainfo_install,org.querencia.Files)
	install -D -m 0644 debian/install-source.toml $(DESTDIR)/usr/share/querencia-files/install-source.toml
	install -D -m 0644 debian/README.Debian $(DESTDIR)/usr/share/doc/querencia-files/README.Debian
	$(call doc_install,.)
	install -D -m 0644 THIRD_PARTY_LICENSES.md $(DESTDIR)/usr/share/doc/querencia-files/THIRD_PARTY_LICENSES.md
	install -d $(DESTDIR)/usr/share/doc/querencia-files/licenses
	install -m 0644 data/licenses/*.txt $(DESTDIR)/usr/share/doc/querencia-files/licenses/
