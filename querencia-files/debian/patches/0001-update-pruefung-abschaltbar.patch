+/// Querencia Files packages are updated by the distribution's package
+/// manager; Strata's release sources (GitHub releases of lgse/strata, AUR)
+/// do not apply to this fork. Set at build time with
+/// `QUERENCIA_DISABLE_UPDATE_CHECKS=1` (querencia-packaging does): no
+/// automatic or manual update check and no release-notes request then
+/// leaves the machine.
+pub(crate) const UPDATE_CHECKS_DISABLED: bool =
+    option_env!("QUERENCIA_DISABLE_UPDATE_CHECKS").is_some();
+
 const API_ROOT: &str = "https://api.github.com/repos/lgse/strata/releases";
 const COMMITS_ROOT: &str = "https://api.github.com/repos/lgse/strata/commits";
 const RELEASES_URL: &str = "https://github.com/lgse/strata/releases";
@@ -660,6 +669,15 @@ pub fn check_for_updates(
     force: bool,
 ) -> Receiver<UpdateCheck> {
     let (sender, receiver) = mpsc::channel();
+    if UPDATE_CHECKS_DISABLED {
+        let instruction = super::InstallSource::detect()
+            .managed()
+            .cloned()
+            .unwrap_or_default()
+            .update_instruction();
+        let _sent = sender.send(UpdateCheck::Failed(instruction));
+        return receiver;
+    }
     let spawned = std::thread::Builder::new()
         .name("strata-update-check".into())
         .spawn(move || {
