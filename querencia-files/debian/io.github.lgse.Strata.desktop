[Desktop Entry]
# Bridge for the old desktop ID io.github.lgse.Strata (Querencia Files up to
# Alpha 2.1): hidden from menus and without MIME types, it starts Querencia
# Files under its new ID org.querencia.Files. Links, panel launchers and
# desktop icons that still name the old ID keep working; the bridge goes
# away in a later release.
Type=Application
Version=1.5
Name=Querencia Files
GenericName=File Manager
GenericName[de]=Dateimanager
Comment=Browse folders and files
Comment[de]=Ordner und Dateien durchsuchen
Exec=querencia-files %U
TryExec=querencia-files
Icon=org.querencia.Files
Terminal=false
Categories=GTK;Utility;FileTools;FileManager;
StartupNotify=true
StartupWMClass=org.querencia.Files
NoDisplay=true
