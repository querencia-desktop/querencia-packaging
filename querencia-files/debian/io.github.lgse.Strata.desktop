[Desktop Entry]
# Bridge for the old desktop ID io.github.lgse.Strata (Querencia Files up to
# Alpha 2.1): hidden, without MIME types; since Querencia Dateien replaces
# Files (Welle C, M4) it starts Querencia Dateien. Links, panel launchers and
# user files (also a mimeapps.list) that still name the old ID keep working;
# the bridge stays in the transitional package querencia-files.
Type=Application
Version=1.5
Name[de]=Querencia Dateien
Name=Files
GenericName[de]=Dateimanager
GenericName=File Manager
Comment[de]=Ordner durchsuchen und Dateien verwalten
Comment=Browse folders and manage files
Exec=querencia-dateien %U
TryExec=querencia-dateien
Icon=org.querencia.Dateien
Terminal=false
Categories=GTK;Utility;FileTools;FileManager;
StartupNotify=true
StartupWMClass=org.querencia.Dateien
NoDisplay=true
