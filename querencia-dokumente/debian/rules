#!/usr/bin/make -f
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

querencia-install:
	install -D -m 0755 target/release/querencia-dokumente $(DESTDIR)/usr/bin/querencia-dokumente
	$(call desktop_install,data/org.querencia.Dokumente.desktop,$(DESTDIR)/usr/share/applications/org.querencia.Dokumente.desktop)
	# Programmsymbol kommt seit querencia-symbole 0.6 von dort (Depends)
	$(call mo_install,po,querencia-dokumente)
	$(call metainfo_install_from,data,org.querencia.Dokumente)
	$(call doc_install,.)
