<component type="desktop-application">
  <id>org.querencia.Systemmonitor</id>
  <name>Querencia System Monitor</name>
  <name xml:lang="de">Querencia Systemüberwachung</name>
  <summary>View current processes and monitor system state</summary>
  <summary xml:lang="de">Laufende Prozesse anzeigen und den Systemzustand überwachen</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
