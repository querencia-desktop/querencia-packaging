<?xml version="1.0" encoding="UTF-8"?>
<!-- Querencia Files QF-0t: Komponenten-ID org.querencia.Files = GApplication-ID = Desktop-ID (QD-059).
     Abgeleitet aus io.github.lgse.Strata.metainfo.xml (SW-5, Querencia Software, 2026-10-18);
     die alte ID steht unter <provides>, damit Kataloge und Software den Eintrag weiter zuordnen.
     Metadaten unter FSFAP, damit Kataloge sie frei übernehmen dürfen. -->
<component type="desktop-application">
  <id>org.querencia.Files</id>
  <name>Querencia Files</name>
  <name xml:lang="de">Querencia Files</name>
  <summary>Browse folders and files</summary>
  <summary xml:lang="de">Ordner und Dateien durchsuchen</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>MIT</project_license>
  <developer id="org.querencia">
    <name>Querencia Desktop</name>
    <name xml:lang="de">Querencia Desktop</name>
  </developer>
  <project_group>Querencia</project_group>
  <description>
    <p>Querencia Files is the file manager of Querencia Desktop. It shows folders and files in the classic look of Nautilus 2 with the GNOME Human icon theme, opens files with their applications, manages the trash and connects to network shares over GVfs.</p>
    <p xml:lang="de">Querencia Files ist der Dateimanager von Querencia Desktop. Er zeigt Ordner und Dateien im klassischen Aussehen von Nautilus 2 mit dem Symbolthema GNOME Human, öffnet Dateien mit ihren Programmen, verwaltet den Papierkorb und verbindet sich über GVfs mit Netzwerkfreigaben.</p>
    <p>Querencia Files is derived from the Strata file manager by LGSE Ltd. (MIT license).</p>
    <p xml:lang="de">Querencia Files ist eine Weiterentwicklung des Dateimanagers Strata von LGSE Ltd. (MIT-Lizenz).</p>
  </description>
  <url type="homepage">https://querencialinux.org</url>
  <url type="bugtracker">https://github.com/querencia-desktop/querencia/issues</url>
  <url type="vcs-browser">https://github.com/querencia-desktop/querencia-files</url>
  <launchable type="desktop-id">org.querencia.Files.desktop</launchable>
  <provides>
    <id>io.github.lgse.Strata</id>
    <binary>querencia-files</binary>
    <mediatype>inode/directory</mediatype>
  </provides>
  <pkgname>querencia-files</pkgname>
  <categories>
    <category>Utility</category>
    <category>FileTools</category>
    <category>FileManager</category>
  </categories>
  <keywords>
    <keyword>files</keyword>
    <keyword>folders</keyword>
    <keyword>file manager</keyword>
    <keyword xml:lang="de">Dateien</keyword>
    <keyword xml:lang="de">Ordner</keyword>
    <keyword xml:lang="de">Dateimanager</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#F07746</color>
    <color type="primary" scheme_preference="dark">#B8532B</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-10-18"/>
  </releases>
</component>
