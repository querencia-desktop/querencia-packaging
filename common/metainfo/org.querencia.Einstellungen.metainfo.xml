<component type="desktop-application">
  <id>org.querencia.Einstellungen</id>
  <name>Querencia Settings</name>
  <name xml:lang="de">Querencia Einstellungen</name>
  <summary>Change the desktop background and other settings of Querencia</summary>
  <summary xml:lang="de">Hintergrund der Arbeitsfläche und weitere Einstellungen von Querencia ändern</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.querencia">
    <name>Querencia Desktop</name>
    <name xml:lang="de">Querencia Desktop</name>
  </developer>
  <project_group>Querencia</project_group>
  <description>
    <p>Querencia Settings is the control centre of Querencia Desktop in the style of GNOME 2. The first area sets the desktop background (colour, picture, centred, tiled); further areas such as the screen (resolution, scale, monitors) are being added.</p>
    <p xml:lang="de">Querencia Einstellungen ist das Kontrollzentrum von Querencia Desktop im Stil von GNOME 2. Der erste Bereich stellt den Hintergrund der Arbeitsfläche ein (Farbe, Bild, zentriert, gekachelt); weitere Bereiche wie Bildschirm (Auflösung, Skalierung, Monitore) kommen hinzu.</p>
  </description>
  <url type="homepage">https://querencialinux.org</url>
  <launchable type="desktop-id">org.querencia.Einstellungen.desktop</launchable>
