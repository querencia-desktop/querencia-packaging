<!-- Querencia Bilder 0.1.0 (Prototyp W5 8845066, Paket querencia-bilder 0.1.0~alpha1-2, live seit G2-E als „Bildbetrachter“ unter Zubehör; die Live-Desktop-Datei trägt Utility statt Graphics auf Besitzerentscheidung – der Installer zeigt den Eintrag über diese Kategorien unter Grafik, das Panelmenü bleibt unberührt).
     Erzeugt von werkzeug/metainfo-erzeugen.py (SW-5, Querencia Software, 2026-10-18);
     Metadaten unter FSFAP, damit Kataloge sie frei übernehmen dürfen. -->
<component type="desktop-application">
  <id>org.querencia.Bilder</id>
  <name>Querencia Images</name>
  <name xml:lang="de">Querencia Bilder</name>
  <summary>View images</summary>
  <summary xml:lang="de">Bilder ansehen</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.querencia">
    <name>Querencia Desktop</name>
    <name xml:lang="de">Querencia Desktop</name>
  </developer>
  <project_group>Querencia</project_group>
  <description>
    <p>Querencia Images is the image viewer of Querencia Desktop. It shows PNG, JPEG, GIF, BMP, WebP, SVG and every other format gdk-pixbuf can load, with a classic menu bar, a compact toolbar, zoom, fit to window, full screen, slideshow, rotation and image properties.</p>
    <p xml:lang="de">Querencia Bilder ist der Bildbetrachter von Querencia Desktop. Er zeigt PNG, JPEG, GIF, BMP, WebP, SVG und jedes andere Format, das gdk-pixbuf laden kann, mit klassischer Menüleiste, kompakter Werkzeugleiste, Zoom, Einpassen, Vollbild, Diashow, Drehen und Bildeigenschaften.</p>
    <p>Images are only displayed, never modified or saved.</p>
    <p xml:lang="de">Bilder werden nur angezeigt, nie verändert oder gespeichert.</p>
  </description>
  <url type="homepage">https://querencialinux.org</url>
  <launchable type="desktop-id">org.querencia.Bilder.desktop</launchable>
  <provides>
    <binary>querencia-bilder</binary>
    <mediatype>image/png</mediatype>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/gif</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/bmp</mediatype>
    <mediatype>image/svg+xml</mediatype>
  </provides>
  <pkgname>querencia-bilder</pkgname>
  <categories>
    <category>Graphics</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>image</keyword>
    <keyword>photo</keyword>
    <keyword>viewer</keyword>
    <keyword xml:lang="de">Bild</keyword>
    <keyword xml:lang="de">Foto</keyword>
    <keyword xml:lang="de">Betrachter</keyword>
    <keyword xml:lang="de">Bildbetrachter</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#F07746</color>
    <color type="primary" scheme_preference="dark">#B8532B</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-10-18"/>
  </releases>
</component>
