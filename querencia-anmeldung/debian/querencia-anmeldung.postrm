#!/bin/sh
# purge: Zustand und Protokoll von ReGreet, die Sitzungsliste und die
# debconf-Einträge entfernen. Zeigt danach noch ein Eintrag auf die Querencia Anmeldung
# (prerm lief nicht durch), wird er entfernt statt ins Leere zu zeigen.
set -e

THIS=querencia-anmeldung
R=${DPKG_ROOT:-}
DMF=$R/etc/X11/default-display-manager
DMS=$R/etc/systemd/system/display-manager.service

if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -L "$DMS" ] && [ "$(basename "$(readlink "$DMS")")" = "$THIS.service" ]; then
        rm -f "$DMS"
    fi
    if [ -s "$DMF" ] && [ "$(basename "$(grep -v '^[[:space:]]*#' "$DMF" | head -n 1)")" = "$THIS" ]; then
        rm -f "$DMF"
    fi
    if [ -z "$R" ] && [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null 2>&1 || true
    fi
fi

if [ "$1" = purge ]; then
    rm -rf "$R/var/lib/querencia-anmeldung" "$R/var/log/querencia-anmeldung" "$R/run/querencia-anmeldung"
    if [ -e /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_purge
    fi
fi

exit 0
