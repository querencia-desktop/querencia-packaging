 fn system_locale() -> Locale {
+    // The time locale as POSIX resolves it (LC_ALL, LC_TIME, LANG), e.g.
+    // "de_DE.UTF-8" -> de_DE; `sys_locale` ignores LC_TIME and returns
+    // "de-DE", which `Locale` does not parse.
