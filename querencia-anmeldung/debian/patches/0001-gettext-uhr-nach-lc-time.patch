 pub use component::GreeterInit;
+
+/// Translate a visible text through the gettext catalog of the
+/// `querencia-anmeldung` package; untranslated texts stay unchanged.
+pub(crate) fn tr(msgid: &str) -> String {
+    relm4::gtk::glib::dgettext(Some("querencia-anmeldung"), msgid).into()
+}
+
+/// Translate a text from PAM (passed on by greetd, which sets no locale):
+/// first through the `querencia-anmeldung` catalog, then through the one
+/// of Linux-PAM itself; untranslated texts stay unchanged.
+pub(crate) fn tr_pam(msgid: &str) -> String {
+    // gettext returns the catalog header for an empty msgid
+    if msgid.trim_end().is_empty() {
+        return String::new();
+    }
+    let own = tr(msgid.trim_end());
+    if own != msgid.trim_end() {
+        return own;
+    }
+    let pam: String = relm4::gtk::glib::dgettext(Some("Linux-PAM"), msgid).into();
+    pam.trim_end().to_string()
+}
 pub use model::Greeter;
