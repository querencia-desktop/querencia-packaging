#!/usr/bin/make -f
# Quellbaum: ReGreet 0.5.0 (Upstream) im Hauptordner, die Querencia-Teile
# (Konfiguration, Startskripte, Doku, Übersetzung) aus dem Repository
# querencia-anmeldung als Komponente unter querencia/. Einziger Patch an
# ReGreet: debian/patches/0001-gettext-uhr-nach-lc-time.patch (sichtbare
# Texte über gettext, Uhr nach LC_TIME; Entscheidung der Startsession vom
# 22.10.2026).
QUERENCIA_KIND := rust
QUERENCIA_TEST := yes
CARGO_FEATURES :=
include debian/querencia.mk

# Pfade, die ReGreet beim Bau übernimmt (src/constants.rs): eigene Ordner,
# damit nichts mit /etc/greetd oder einem anderen ReGreet zusammenstößt.
export GREETD_CONFIG_DIR := /etc/querencia/greetd
export STATE_DIR := /var/lib/querencia-anmeldung
export LOG_DIR := /var/log/querencia-anmeldung
# Sitzungen nur aus der Liste von sitzungen-auswahl (Querencia und
# freigegebene, jede über die Sitzungshülle); anmeldung-starten startet
# ReGreet ohne XDG_DATA_DIRS, das sonst Vorrang hätte.
export SESSION_DIRS := /run/querencia-anmeldung/wayland-sessions
export REBOOT_CMD := systemctl reboot
export POWEROFF_CMD := systemctl poweroff

Q := querencia
LIBEXEC := $(DESTDIR)/usr/libexec/querencia-anmeldung
DOC := $(DESTDIR)/usr/share/doc/$(PKG)

querencia-install:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	sh $(Q)/tests/konfig-pruefen.sh $(Q)
	sh $(Q)/tests/uebersetzung-pruefen.sh . $(Q)/po/de.po
endif
	# der Patch ist angewendet (Text, den es nur mit ihm gibt)
	grep -q 'Wrong password. Please try again.' target/release/regreet
	# seit 0.1.3: Meldungen von PAM auch über den Katalog von Linux-PAM
	grep -q 'Linux-PAM' target/release/regreet
	# seit 0.1.4: eigene Meldung bei abgelaufenem Passwort
	grep -q 'Your password has expired. Please choose a new one.' target/release/regreet
	# die eingebauten Pfade müssen im Binary stehen
	grep -q /etc/querencia/greetd target/release/regreet
	grep -q /var/lib/querencia-anmeldung target/release/regreet
	grep -q /run/querencia-anmeldung/wayland-sessions target/release/regreet
	! grep -q /usr/share/wayland-sessions target/release/regreet
	install -D -m 0755 target/release/regreet $(LIBEXEC)/regreet
	install -D -m 0755 $(Q)/libexec/anmeldung-starten $(LIBEXEC)/anmeldung-starten
	install -D -m 0755 $(Q)/libexec/sitzungen-auswahl $(LIBEXEC)/sitzungen-auswahl
	install -D -m 0755 $(Q)/libexec/sitzung-starten $(LIBEXEC)/sitzung-starten
	install -D -m 0755 $(Q)/sbin/querencia-anmeldung $(DESTDIR)/usr/sbin/querencia-anmeldung
	install -D -m 0644 $(Q)/config/greetd/config.toml $(DESTDIR)/etc/querencia/greetd/config.toml
	install -D -m 0644 $(Q)/config/greetd/regreet.toml $(DESTDIR)/etc/querencia/greetd/regreet.toml
	install -D -m 0644 $(Q)/config/greetd/sitzungen.conf $(DESTDIR)/etc/querencia/greetd/sitzungen.conf
	install -D -m 0644 $(Q)/config/greetd/labwc/rc.xml $(DESTDIR)/etc/querencia/greetd/labwc/rc.xml
	install -D -m 0644 $(Q)/config/greetd/labwc/menu.xml $(DESTDIR)/etc/querencia/greetd/labwc/menu.xml
	install -D -m 0644 $(Q)/config/greetd/labwc/environment $(DESTDIR)/etc/querencia/greetd/labwc/environment
	install -D -m 0644 $(Q)/systemd/querencia-anmeldung.service \
		$(DESTDIR)/usr/lib/systemd/system/querencia-anmeldung.service
	install -D -m 0644 $(Q)/tmpfiles/querencia-anmeldung.conf \
		$(DESTDIR)/usr/lib/tmpfiles.d/querencia-anmeldung.conf
	install -d $(DESTDIR)/usr/share/locale/de/LC_MESSAGES
	msgfmt -c -o $(DESTDIR)/usr/share/locale/de/LC_MESSAGES/querencia-anmeldung.mo $(Q)/po/de.po
	install -D -m 0644 $(Q)/man/querencia-anmeldung.8 $(DESTDIR)/usr/share/man/man8/querencia-anmeldung.8
	$(call doc_install,$(Q))
	install -m 0644 $(Q)/docs/umschalten.md $(DOC)/umschalten.md
	install -m 0644 README.md $(DOC)/README.regreet.md
	install -D -m 0644 regreet.sample.toml $(DOC)/examples/regreet.sample.toml
