#!/bin/sh
# debconf-Konfiguration: Welcher Display-Manager ist Standard?
#
# Wie bei gdm3 und lightdm ist die gemeinsame Frage
# shared/default-x-display-manager die Auswahl; was beim Start wirklich
# läuft, steht in /etc/X11/default-display-manager bzw. im Link
# display-manager.service (debconf ist kein Register). Dieses Skript
# entscheidet nur, die Änderung macht postinst (querencia-anmeldung/ziel).
#
# Regeln (docs/umschalten.md im Repository querencia-anmeldung):
#  - QUERENCIA_ANMELDUNG=ja       Querencia Anmeldung wird Standard.
#  - QUERENCIA_ANMELDUNG=nein     nichts einschalten; ist sie Standard,
#                                 zurück zum vorherigen bzw. einem anderen.
#  - kein Display-Manager eingerichtet: Querencia Anmeldung wird Standard.
#  - ein anderer Display-Manager mit debconf-Eintrag (gdm3, lightdm, sddm):
#    bleibt vorbelegt; die Frage erscheint (Priorität high), ohne Antwort
#    (noninteractive) bleibt er.
#  - ein von Hand eingerichteter Dienst ohne debconf-Eintrag: bleibt;
#    umschalten nur mit dpkg-reconfigure oder QUERENCIA_ANMELDUNG=ja.
#  - display-manager.service maskiert: nichts ändern.
set -e

. /usr/share/debconf/confmodule

THIS=querencia-anmeldung
FRAGE=shared/default-x-display-manager
DMF=${DPKG_ROOT:-}/etc/X11/default-display-manager
DMS=${DPKG_ROOT:-}/etc/systemd/system/display-manager.service

OWNERS=
if db_metaget $FRAGE owners; then OWNERS=$RET; fi
CHOICES=
if db_metaget $FRAGE choices; then CHOICES=$RET; fi
if [ "$OWNERS" != "$CHOICES" ]; then
    db_subst $FRAGE choices "$OWNERS" || true
    db_fset $FRAGE seen false || true
fi

ist_eigentuemer() {
    case ", $OWNERS," in *", $1,"*) return 0 ;; esac
    return 1
}

# Aktiver Display-Manager: Name eines debconf-Eigentümers (AKTUELL) oder ein
# Dienst ohne debconf-Eintrag (FREMD).
AKTUELL=
FREMD=
MASKIERT=
if [ -s "$DMF" ]; then
    AKTUELL=$(basename "$(grep -v '^[[:space:]]*#' "$DMF" | head -n 1)")
fi
if [ -L "$DMS" ] && [ "$(readlink "$DMS")" = /dev/null ]; then
    MASKIERT=ja
elif [ -z "$AKTUELL" ] && [ -L "$DMS" ]; then
    FREMD=$(basename "$(readlink "$DMS")" .service)
fi
if [ -n "$AKTUELL" ] && ! ist_eigentuemer "$AKTUELL"; then
    FREMD=$AKTUELL
    AKTUELL=
fi

# erster anderer Eigentümer der Frage (Rückweg für QUERENCIA_ANMELDUNG=nein)
anderer() {
    for o in $(echo "$OWNERS" | tr ',' ' '); do
        if [ "$o" != "$THIS" ]; then echo "$o"; return 0; fi
    done
}

WUNSCH=${QUERENCIA_ANMELDUNG:-}
case $WUNSCH in
ja | nein | "") ;;
*) echo "querencia-anmeldung: QUERENCIA_ANMELDUNG=$WUNSCH unbekannt (ja|nein), ignoriert" >&2; WUNSCH= ;;
esac

ZIEL=
if [ -n "$MASKIERT" ]; then
    :
elif [ "$WUNSCH" = ja ]; then
    ZIEL=$THIS
    db_set $FRAGE $THIS
    db_fset $FRAGE seen true
elif [ "$WUNSCH" = nein ]; then
    if [ "$AKTUELL" = "$THIS" ]; then
        ZIEL=$(anderer)
        [ -n "$ZIEL" ] || ZIEL=-
        [ "$ZIEL" = - ] || db_set $FRAGE "$ZIEL"
    elif [ -n "$AKTUELL" ]; then
        db_set $FRAGE "$AKTUELL"
    fi
elif [ "$1" = reconfigure ]; then
    # ausdrücklicher Aufruf: immer fragen, vorbelegt mit dem aktiven
    if [ -n "$AKTUELL" ]; then db_set $FRAGE "$AKTUELL"; else db_set $FRAGE $THIS; fi
    db_fset $FRAGE seen false
    db_input high $FRAGE || true
    db_go || true
    db_get $FRAGE
    if ist_eigentuemer "$RET" && { [ "$RET" != "$AKTUELL" ] || [ -n "$FREMD" ]; }; then
        ZIEL=$RET
    fi
elif [ -n "$FREMD" ]; then
    # von Hand eingerichteter Dienst: nicht ungefragt ersetzen
    :
elif [ -z "$AKTUELL" ]; then
    # kein Display-Manager eingerichtet: nur bei der Erstinstallation
    # übernehmen (wer später bewusst auf die Textkonsole zurückgeschaltet
    # hat, behält sie bei Aktualisierungen)
    if [ -z "${2:-}" ]; then
        db_set $FRAGE $THIS
        db_input high $FRAGE || true
        db_go || true
        db_get $FRAGE
        if ist_eigentuemer "$RET"; then ZIEL=$RET; fi
    fi
else
    # Ein anderer mit debconf-Eintrag ist aktiv. Nur fragen, solange die
    # Frage nicht beantwortet ist (neue Auswahl); config läuft bei apt
    # zweimal (dpkg-preconfigure, postinst), der zweite Lauf darf die
    # Antwort des ersten nicht überschreiben.
    db_fget $FRAGE seen || RET=false
    if [ "$RET" != true ]; then
        db_set $FRAGE "$AKTUELL"
        db_input high $FRAGE || true
        db_go || true
        db_get $FRAGE
        if ist_eigentuemer "$RET" && [ "$RET" != "$AKTUELL" ]; then ZIEL=$RET; fi
    fi
fi

# Nur eine Entscheidung speichern; postinst leert den Wert nach Gebrauch.
if [ -n "$ZIEL" ]; then db_set $THIS/ziel "$ZIEL"; fi
exit 0
